# ============================================================
# HVAC Digital Twin Platform — Environment Variables
# Copy to .env and fill in all values before running
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_ADMIN_PASSWORD=ChangeThisAdminPassword123!
DB_USER=hvac_user
DB_PASSWORD=ChangeThisPassword123!

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-min-64-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── ThingsBoard ───────────────────────────────────────────────
THINGSBOARD_ADMIN_EMAIL=sysadmin@thingsboard.org
THINGSBOARD_ADMIN_PASSWORD=sysadmin

# ── Daikin Onecta API ─────────────────────────────────────────
DAIKIN_CLIENT_ID=your-daikin-client-id
DAIKIN_CLIENT_SECRET=your-daikin-client-secret
DAIKIN_REDIRECT_URI=https://api.digitaltwin.hellcold.pl/oauth/daikin/callback

# ── Dynamics 365 / Dataverse ──────────────────────────────────
D365_ORG_URI=https://yourorg.crm4.dynamics.com
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret

# ── Autodesk Platform Services (APS) ─────────────────────────
AUTODESK_CLIENT_ID=your-aps-client-id
AUTODESK_CLIENT_SECRET=your-aps-client-secret
