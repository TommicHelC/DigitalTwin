## 5. Viewer – xeokit + Potree

### 5.1. IFC → XKT conversion

**Backend:**
```typescript
// viewer.service.ts
import { execSync } from 'child_process';
import { createReadStream } from 'fs';

@Injectable()
export class ViewerService {
  async uploadAndConvertModel(file: Express.Multer.File, siteId: string): Promise<string> {
    const ifcPath = `/tmp/${file.originalname}`;
    const xktPath = `/data/models/${siteId}/${file.originalname.replace('.ifc', '.xkt')}`;
    
    // Save IFC
    fs.writeFileSync(ifcPath, file.buffer);
    
    // Convert: ifc → xkt (using xeokit's convert2xkt CLI)
    execSync(`npx @xeokit/xeokit-convert ${ifcPath} ${xktPath}`, {
      stdio: 'inherit'
    });
    
    // Store reference in DB
    await this.modelRepository.save({
      siteId,
      name: file.originalname,
      xktPath,
      uploadDate: new Date(),
    });
    
    return xktPath;
  }
}
```

### 5.2. Frontend – xeokit viewer component

```typescript
// components/XeokitViewer.tsx
import React, { useEffect, useRef } from 'react';
import { Viewer } from '@xeokit/xeokit-sdk';
import { XKTLoaderPlugin } from '@xeokit/xeokit-sdk/dist/plugins/XKTLoaderPlugin/XKTLoaderPlugin.js';

interface XeokitViewerProps {
  modelUrl: string;
  deviceId?: string;
  telemetry?: Record<string, number>;
}

export function XeokitViewer({ modelUrl, deviceId, telemetry }: XeokitViewerProps) {
  const containerRef = useRef<HTMLDivElement>(null);
  const viewerRef = useRef<Viewer | null>(null);

  useEffect(() => {
    if (!containerRef.current) return;

    // Initialize viewer
    viewerRef.current = new Viewer({
      canvasElement: containerRef.current,
    });

    // Load XKT model
    const xkt = new XKTLoaderPlugin(viewerRef.current);
    xkt.load(`/models/${modelUrl}`, (err?: any) => {
      if (!err) {
        viewerRef.current?.scene.setStandardView(); // zoom fit
      }
    });

    // If deviceId provided: highlight device entity
    if (deviceId && viewerRef.current) {
      const entity = viewerRef.current.scene.objects[deviceId];
      if (entity) {
        entity.highlighted = true;
      }
    }

    return () => {
      viewerRef.current?.destroy();
    };
  }, [modelUrl, deviceId]);

  return (
    <div className="flex h-full">
      <div ref={containerRef} style={{ width: '70%', height: '100%' }} />
      <div style={{ width: '30%', padding: '1rem', borderLeft: '1px solid #ccc' }}>
        {telemetry && (
          <div>
            <h3>Live Data</h3>
            {Object.entries(telemetry).map(([key, value]) => (
              <div key={key}>{key}: {value}</div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}
```

